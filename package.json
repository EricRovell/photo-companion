{
	"name": "photo-companion-monorepo",
	"description": "Minimalistic photography toolkit progressive web application.",
	"private": true,
	"type": "module",
	"author": "Eric Rovell",
	"license": "MIT",
	"homepage": "https://github.com/EricRovell/photo-companion#readme",
	"scripts": {
		"build": "pnpm --filter ./packages/photo-companion run build",
		"build:storybook": "pnpm --filter photo-companion run build:storybook",
		"preview": "pnpm --filter ./packages/photo-companion run preview",
		"storybook": "pnpm --filter photo-companion run storybook",
		"clean": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
		"dev": "pnpm --filter photo-companion run dev",
		"knip": "knip",
		"test:unit": "vitest run",
		"test:unit:ci": "vitest run --coverage",
		"lint": "pnpm lint:code && pnpm lint:types && pnpm lint:styles && pnpm lint:ls && pnpm knip",
		"lint:all": "pnpm lint",
		"lint:code": "eslint",
		"lint:code:fix": "eslint --fix",
		"lint:styles": "npx stylelint packages/**/*.css",
		"lint:types": "pnpm --parallel run lint:types && tsc -p tsconfig.eslint.json",
		"lint:ls": "ls-lint",
		"eslint:inspector": "eslint --inspect-config"
	},
	"keywords": [
		"photography",
		"scheduler",
		"web-application"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ls-lint/ls-lint": "^2.3.1",
		"@stylistic/stylelint-plugin": "^5.3.1",
		"@types/node": "^22.18.13",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-plugin-perfectionist": "^5.12.1",
		"eslint-plugin-solid": "^0.18.1",
		"knip": "^6.41.0",
		"postcss-nesting": "^14.0.3",
		"rollup-plugin-visualizer": "^5.14.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.72.0",
		"vite": "catalog:default",
		"vite-plugin-solid": "^2.11.14",
		"vitest": "^5.0.5"
	},
	"workspaces": [
		"packages/*"
	],
	"packageManager": "pnpm@9.5.0"
}
