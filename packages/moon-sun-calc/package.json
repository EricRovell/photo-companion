{
	"name": "moon-sun-calc",
	"version": "0.2.0",
	"private": true,
	"description": "Typed Meeus-based Sun and Moon positions, phases, and UTC interval events.",
	"keywords": [
		"sun",
		"moon",
		"astronomy",
		"meeus",
		"sunrise",
		"sunset",
		"twilight"
	],
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"sideEffects": false,
	"scripts": {
		"build": "node scripts/clean-dist.js && node esbuild.js && pnpm build:types",
		"build:types": "tsc -p tsconfig.json",
		"lint:types": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"utils": "workspace:*"
	},
	"devDependencies": {
		"esbuild": "^0.19.11"
	}
}
