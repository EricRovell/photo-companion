{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"composite": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"strict": true
	},
	"include": [
		"vite.config.ts",
		"vitest.config.ts",
		"./plugins/*.ts"
	]
}
